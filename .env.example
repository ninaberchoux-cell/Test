# Database
DATABASE_URL=postgresql://vacation:vacation_secret@localhost:5432/vacation_inbox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id

# Microsoft Graph
GRAPH_WEBHOOK_SECRET=your-random-secret-string

# OpenAI
OPENAI_API_KEY=sk-...

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-32chars

# App
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
NODE_ENV=development

# Encryption key for token storage (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
